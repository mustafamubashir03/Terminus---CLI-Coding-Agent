# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.env
# Virtual environments
.venv
# Legacy pre-.terminus storage paths, kept so an old checkout is still covered.
.chromadb/
.memory/
.qdrant/
# Terminus runtime state: LangGraph checkpointer, task database, index
# manifest, and the local vector stores. All of it is derived from the working
# tree and is rebuildable, and some of it is large (the checkpointer grows with
# every conversation), so none of it belongs in version control.
.terminus/
# Scratch workspace for the Docker sandbox integration tests. They need a real
# directory inside the checkout rather than a temp one - see the `workspace`
# fixture in tests/test_sandbox_docker.py - so ignore it in case a run is
# interrupted between creating it and cleaning it up.
.sandbox-integration/
